@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<urn:davidian:ashgrove-classic-lead> a lv2:Plugin ;
    lv2:binary <ashgrove.dylib> ;
    rdfs:seeAlso <ashgrove.ttl> ;
    <http://lv2plug.in/ns/extensions/ui#ui> <urn:davidian:ashgrove-classic-lead#ui> .

<urn:davidian:ashgrove-classic-lead#ui> a <http://lv2plug.in/ns/extensions/ui#CocoaUI> ;
    <http://lv2plug.in/ns/extensions/ui#binary> <ashgrove_ui.dylib> ;
    lv2:optionalFeature <http://lv2plug.in/ns/extensions/ui#resize> ,
        <http://lv2plug.in/ns/extensions/ui#parent> ,
        <http://lv2plug.in/ns/extensions/ui#idleInterface> ;
    lv2:extensionData <http://lv2plug.in/ns/extensions/ui#idleInterface> .

